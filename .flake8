[flake8]
max-line-length = 127
max-complexity = 10
disable-noqa = False

# F722 "syntax error in forward annotation" is a false positive on every
# jaxtyping shape in the codebase -- flake8 cannot parse
# `Float[torch.Tensor, "batch pos"]`. There are ~125 of these.
#
# The single-token case (`Float[torch.Tensor, "d_vocab"]`) is reported as
# F821 instead, since flake8 reads it as a forward reference. Those are
# marked `# noqa: F821` individually so F821 stays enabled as a real check.
extend-ignore = F722

exclude =
    .git,
    __pycache__,
    build,
    dist,
    .pytest_cache,
    notebooks
